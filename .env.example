# ============================================================================
# Environment Configuration for Dashboard UI Tests
# Copy this file to .env and fill in with your actual values
# Target site: practice.expandtesting.com (same env var names as the sibling
# Playwright repo, for a consistent config story across both frameworks)
# ============================================================================

# === SYSTEM UNDER TEST ===
BASE_URL=https://practice.expandtesting.com
NOTES_API_URL=https://practice.expandtesting.com/notes/api

# === WEB LOGIN CREDENTIALS ===
# These are the publicly documented practice credentials for this site -
# not a secret, but kept as env vars to demonstrate the no-hardcoded-values pattern
DEFAULT_USERNAME=practice
DEFAULT_PASSWORD=SuperSecretPassword!

# === BROWSER SETTINGS ===
BROWSER=Chrome
# Options: Chrome, Firefox, Edge

# === SELENIUM GRID (Docker Compose) ===
# Set to a Grid hub URL to run against Selenium Grid instead of a local driver
REMOTE_URL=

# === ENVIRONMENT ===
ENV=STAGING
# Options: STAGING, PROD - both resolve to the same real BASE_URL today

# === TIMEOUTS (in seconds) ===
DEFAULT_TIMEOUT=60
SHORT_TIMEOUT=3
VERY_SHORT_TIMEOUT=1

# === REPORT SETTINGS ===
REPORT_DIR=reports
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARN, ERROR

# === OPTIONAL: PROXY SETTINGS ===
# HTTP_PROXY=http://proxy.yourdomain.com:8080
# HTTPS_PROXY=https://proxy.yourdomain.com:8080
